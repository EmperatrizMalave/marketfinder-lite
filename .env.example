# MarketFinder Lite — variables de entorno (ejemplo sin secretos)
# Copia este archivo a .env y completa los valores cuando tengas una app
# registrada en developers.mercadolibre.com. Nunca subas .env a Git.

# Identificadores de la aplicación en Mercado Libre Developers
ML_CLIENT_ID=
ML_CLIENT_SECRET=

# Token de acceso OAuth (se obtiene tras el flujo de autorización)
ML_ACCESS_TOKEN=

# Refresh token (opcional; útil para renovar el access token)
ML_REFRESH_TOKEN=

# Site de Mercado Libre (México = MLM)
ML_SITE_ID=MLM

# Entorno de la app: development | production
APP_ENV=development
